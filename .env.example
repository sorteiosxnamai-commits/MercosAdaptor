# Produção (após homologação Mercos):
# MERCOS_BASE_URL=https://app.mercos.com/api/v1
# NÃO use api.mercos.com — esse host não é a API de integração.
MERCOS_BASE_URL=https://sandbox.mercos.com/api/v1
MERCOS_APPLICATION_TOKEN=
MERCOS_COMPANY_TOKEN=
MERCOS_ADAPTOR_API_KEY=troque-por-uma-chave-interna-forte
MERCOS_TIMEOUT_SECONDS=60
MERCOS_MAX_RETRIES=4
MERCOS_DEFAULT_RETRY_SECONDS=6
MERCOS_MAX_PAGES=500
MERCOS_PAGE_PAUSE_SECONDS=0.25
MERCOS_VERIFY_SSL=true
LOG_LEVEL=INFO

# --- ERP Xnamai (aditivo; a chave legada acima continua igual) ---
# Chave exclusiva do ERP. Sem escopos de escrita ela só LÊ.
MERCOS_ERP_API_KEY=
# read | write:customers | write:orders | write:titles | write:products | write:stock
# | write:billing | write:order-cancel | write:payment-methods
MERCOS_ERP_SCOPES=read
# Extensões ainda não validadas no sandbox. Liste só depois de validar, ex.:
# read.titles,read.payments,read.commissions,write.stock,write.billing
MERCOS_ENABLED_EXTENSIONS=
# Coordenação de cota entre réplicas. Vazio = 1 instância (coordenação local).
# Com Redis configurado, se ele cair as chamadas FALHAM (503); não há fallback permissivo.
MERCOS_REDIS_URL=
MERCOS_GATE_WAIT_SECONDS=120
